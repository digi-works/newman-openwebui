{
	email {$ACME_EMAIL}
	servers {
		# A request whose Host header is not the site it reached over TLS (Host: evil.example on a connection made to this site) is
		# refused with 421 Misdirected Request, instead of Caddy's empty 200 for a host it has no site for (QA DEF-46).
		strict_sni_host on
	}
}

{$DIGI_DOMAIN} {
	encode zstd gzip

	header {
		# Browsers use HTTPS only for this site from now on (one year).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# What pages may load. Next.js renders inline scripts and styles, and Digi's in-chat forms (sandboxed iframes) use Google Fonts.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	# Digi is a signed-in app, so crawlers are asked to stay out; there is no sitemap. Answered here as plain text, not the portal's HTML 404 page.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond "User-agent: *
Disallow: /
" 200
	}
	handle /sitemap.xml {
		respond "Not found" 404
	}

	# The tool API is for the Open WebUI server only (and still needs the shared key). Everyone else gets 403.
	@internal path /api/internal/*
	handle @internal {
		@owui remote_ip {$OWUI_ALLOWED_IP}
		handle @owui {
			reverse_proxy portal:3000
		}
		respond "Forbidden" 403
	}

	# API paths always answer in JSON, like the portal's own errors ({"error": ...}). The portal now does this itself; this stays for an
	# older portal image, whose HTML 404 page for an API path with no route is turned into JSON. "code" tells it apart from "no such record".
	handle /api/* {
		# Never cached, including answers made here or by an older portal image that sets no Cache-Control (QA DEF-56).
		header ?Cache-Control "no-store"
		# A method the portal never implements (TRACE, PURGE, made-up ones) is 501 in JSON. The portal's server would answer TRACE with a 500
		# and a made-up method with an empty 400 before the portal sees it. A method a route does not take is the portal's 405, with Allow.
		@odd_method not method GET HEAD POST PUT PATCH DELETE OPTIONS
		header @odd_method Content-Type "application/json"
		respond @odd_method `{"error":"The API does not support {method}.","code":"method_not_implemented"}` 501
		reverse_proxy portal:3000 {
			@no_route {
				status 404
				header Content-Type text/html*
			}
			handle_response @no_route {
				header Content-Type "application/json"
				respond `{"error":"No such API endpoint.","code":"no_such_endpoint"}` 404
			}
		}
	}

	reverse_proxy portal:3000
}
