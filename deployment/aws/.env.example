# Copy to .env (cp .env.example .env) and fill in. Never commit or share .env.
# Generate secrets with:  openssl rand -base64 32   (each one different)

# --- Who and where ---------------------------------------------------------
DIGI_DOMAIN=digi.example.edu          # DNS A record must point at this server's public (Elastic) IP
ACME_EMAIL=it@example.edu             # Let's Encrypt expiry notices
TENANT_SLUG=newman                    # short id, lowercase, no spaces; never changes later
TENANT_NAME=Newman University
BRAND_NAME=Ask Digi
ADMIN_EMAIL=admin@example.edu         # the first Admin; temporary password is created in step 4
ADMIN_NAME=Administrator

# --- Digi's secrets (generate each) -----------------------------------------
DIGI_PG_SUPERUSER_PASSWORD=
DIGI_OWNER_PASSWORD=
DIGI_APP_PASSWORD=
PORTAL_INTERNAL_KEY=                  # shared with the Open WebUI tool modules; step 5 installs it there
DIGI_SECRET_KEY=                      # encrypts the saved AI key at rest. LOSING THIS LOSES THAT KEY: back it up apart from the server

# --- The separate Open WebUI instance (required before step 4) -------------
OWUI_URL=https://owui.example.edu     # address the PORTAL uses to reach Open WebUI (https, no trailing slash)
OWUI_ADMIN_TOKEN=                     # an Open WebUI admin API key (Settings > Account > API keys)
OWUI_ALLOWED_IP=203.0.113.10          # the Open WebUI server's public IP (or CIDR): the only address allowed to call /api/internal
OWUI_BASE_MODEL=                      # id of the model in that Open WebUI that Digi should be built on (e.g. gpt-4.1)

# Filled in by connect-owui.py (step 5); leave empty until then
OWUI_RUNTIME_EMAIL=
OWUI_RUNTIME_PASSWORD=
OWUI_RUNTIME_POOL=

# --- Email (optional): room booking emails and calendar invites ---------------
# Sent through Microsoft Graph by an Entra app registration with Mail.Send (application permission, admin consent).
# Leave empty to keep email off; Settings > Notifications then says it is not set up. See README "Room booking emails and calendar invites".
MS_TENANT_ID=                         # Entra > App registrations > the app > Overview > Directory (tenant) ID
MS_CLIENT_ID=                         # same page: Application (client) ID
MS_CLIENT_SECRET=                     # Certificates & secrets > client secret VALUE. A secret: never commit or share it
MAIL_FROM=                            # the mailbox emails come from, e.g. rooms@example.edu
BOOKING_MANAGER_EMAIL=                # first room manager inbox for new requests (changeable later in Settings > Notifications)

# --- Image -------------------------------------------------------------------
PORTAL_IMAGE=digiworks-portal:release   # or your ECR URI, e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com/askdigi:1
